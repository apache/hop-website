---
import Base from './Base.astro'
import Breadcrumbs from '../components/Breadcrumbs.astro'
import OnThisPage from '../components/OnThisPage.astro'
import { getCollection } from 'astro:content'

const { title, description, lede, html = '', wide = false } = Astro.props
const path = Astro.url.pathname
const known = new Set((await getCollection('pages')).map((p) => `/${p.id}/`))
const headings = [...String(html).matchAll(/<h2[^>]*\bid="[^"]+"[^>]*>/g)].length
const hasToc = !wide && headings >= 3
---
<Base title={title} description={description}>
  <main class="page" id="main">
    <div class:list={['page__grid', { 'page__grid--toc': hasToc, 'page__grid--wide': wide }]}>
      <div class="page__col">
        <Breadcrumbs path={path} title={title} known={known} />
        <header class="page__header">
          <h1>{title}</h1>
          {lede && <p class="page__lede">{lede}</p>}
        </header>
        <article class="prose">
          <slot />
        </article>
      </div>
      {hasToc && <OnThisPage html={html} />}
    </div>
  </main>
</Base>

<style>
  .page { max-width: 1180px; margin: 0 auto; padding: 36px 24px 24px; }
  /* One grid owns the measure, so breadcrumbs, header, body and the contents
     list all share a left edge. */
  .page__grid { display: grid; grid-template-columns: minmax(0, 760px); justify-content: center; }
  .page__grid--wide { grid-template-columns: minmax(0, 1fr); }
  .page__col { min-width: 0; }
  @media (min-width: 1080px) {
    .page__grid--toc { grid-template-columns: minmax(0, 760px) 210px; gap: 0 56px; align-items: start; }
  }
  .page__header { margin-bottom: 32px; }
  .page__header h1 { font-size: clamp(30px, 4vw, 42px); letter-spacing: -.028em; margin: 0 0 12px; }
  .page__lede { font-size: 18px; line-height: 1.6; color: var(--ink-2); margin: 0; max-width: 62ch; }
</style>

<style is:global>
  /* The body is Asciidoctor output, so scoped hashes never reach it. */
  .prose { min-width: 0; }
  .prose h2 {
    font-size: clamp(21px, 2.4vw, 26px); margin: 2.2em 0 .5em;
    padding-bottom: .3em; border-bottom: 1px solid var(--rule);
  }
  .prose h3 { font-size: 18.5px; margin: 1.8em 0 .4em; }
  .prose p, .prose li { font-size: 16.5px; line-height: 1.7; }
  .prose ul, .prose ol { padding-left: 1.3em; }
  .prose li + li { margin-top: .35em; }

  .prose table { border-collapse: collapse; width: 100%; font-size: 15px; display: block; overflow-x: auto; }
  .prose table th, .prose table td {
    border: 1px solid var(--rule); padding: 10px 12px; text-align: left; vertical-align: top;
  }
  .prose table th { background: var(--surface-2); font-weight: 600; }
  .prose table td > :last-child { margin-bottom: 0; }

  /* A process rail: the four steps side by side, which is the shape the
     AsciiDoc original used (a cols="4" table) before the conversion turned it
     into a list of jump links competing with the On this page nav. It stays a
     real <ol> in the markup, so the order is in the semantics and not only in
     the numbers. See tools/satteri-directives.mjs for the :::steps syntax. */
  .prose .steps ol {
    counter-reset: step;
    margin: 1.8em 0; padding: 0;
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px;
  }
  /* Empty the marker rather than setting list-style: none. Removing the
     marker outright also removes the list role in Safari, so the count and
     the ordering stop being announced; role="list" restores it but reads as a
     redundant role to a validator. An empty marker keeps both happy. */
  .prose .steps li::marker { content: ""; }
  .prose .steps li {
    counter-increment: step;
    margin: 0; padding: 16px 18px 18px;
    border: 1px solid var(--rule); border-radius: var(--radius);
    background: var(--surface);
  }
  .prose .steps li::before {
    content: counter(step);
    display: block; margin-bottom: 6px;
    font-size: 1.6rem; font-weight: 700; line-height: 1; color: var(--accent);
  }
  .prose .steps li > p { margin: 0 0 0.7em; font-size: 0.92rem; }
  .prose .steps li > p:last-child { margin-bottom: 0; }
  .prose .steps li > p:first-of-type { font-size: 1rem; }
  .prose .steps li > p:first-of-type a { text-decoration: none; }
  .prose .steps li > p:first-of-type a:hover { text-decoration: underline; }
  /* Two up, then stacked. Four narrow columns turn the caveats into slivers
     long before the viewport gets to phone width. */
  @media (max-width: 1080px) { .prose .steps ol { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) { .prose .steps ol { grid-template-columns: 1fr; } }

  /* A checklist: numbered rows meant to be worked through in order, where
     :::steps is for a handful of stages shown side by side. Same reasoning on
     the marker - emptied, not removed, so the list role survives. */
  .prose .checklist ol {
    counter-reset: check;
    margin: 1.6em 0; padding: 0;
    display: grid; gap: 8px;
  }
  .prose .checklist li::marker { content: ""; }
  .prose .checklist li {
    counter-increment: check;
    margin: 0; padding: 12px 16px;
    display: flex; gap: 14px; align-items: baseline;
    border: 1px solid var(--rule); border-radius: var(--radius);
    background: var(--surface);
  }
  .prose .checklist li::before {
    content: counter(check);
    flex: 0 0 1.4em;
    font-weight: 700; font-variant-numeric: tabular-nums; color: var(--accent);
  }
  .prose .checklist a { text-decoration: none; }
  .prose .checklist a:hover { text-decoration: underline; }

  /* Admonitions. The accent is set once per type and read by both the label
     and the left edge, so a new type needs one line. See
     tools/remark-admonitions.mjs for the syntax. */
  .prose .admonition {
    --admonition-accent: var(--note);
    margin: 1.6em 0; padding: 14px 18px;
    border: 1px solid var(--rule); border-left: 3px solid var(--admonition-accent);
    border-radius: var(--radius); background: var(--surface);
  }
  .prose .admonition--tip { --admonition-accent: var(--tip); }
  .prose .admonition--warning { --admonition-accent: var(--warning); }
  .prose .admonition--caution,
  .prose .admonition--important { --admonition-accent: var(--caution); }
  .prose .admonition > :first-child { margin-top: 0; }
  .prose .admonition > :last-child { margin-bottom: 0; }
  .prose .admonition__label {
    margin: 0 0 0.4em; font-size: 0.78rem; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--admonition-accent);
  }

  .prose .imageblock { margin: 1.8em 0; }
  .prose .imageblock img { border: 1px solid var(--rule); border-radius: 8px; background: var(--surface); }
  .prose .title { font-size: 13.5px; color: var(--ink-3); margin-top: 8px; }
  .prose .listingblock { margin: 1.6em 0; }
</style>
