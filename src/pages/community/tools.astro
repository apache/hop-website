---
import Base from '../../layouts/Base.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import Section from '../../components/Section.astro'
import { toolGroups } from '../../data/tools.mjs'
import { getCollection } from 'astro:content'

const known = new Set((await getCollection('pages')).map((p) => `/${p.id}/`))
---
<Base
  title="Tools"
  description="The tools the Apache Hop community works with: GitHub for code and issues, GitHub Actions and Jenkins for builds, the mailing lists and Slack for talking to each other.">
  <main id="main">
    <div class="intro">
      <Breadcrumbs path="/community/tools/" title="Tools" known={known} />
      <h1>Tools</h1>
      <p class="intro__lede">
        Where the work happens. Everything below is public &mdash; you can read the code, the
        discussions, the build logs and the release votes without an account anywhere.
      </p>
    </div>

    {toolGroups.map((group, i) => (
      <Section title={group.title} lede={group.lede} divider={i > 0}>
        <ul class="tools">
          {group.tools.map((t) => (
            <li class="tool">
              <h3><a href={t.href}>{t.name}</a></h3>
              <p>{t.body}</p>
              {t.more && <p class="tool__more"><a href={t.more.href}>{t.more.label} &rarr;</a></p>}
            </li>
          ))}
        </ul>
      </Section>
    ))}
  </main>
</Base>

<style>
  .intro { max-width: 1180px; margin: 0 auto; padding: 36px 24px 0; }
  .intro h1 { font-size: clamp(30px, 4vw, 42px); letter-spacing: -.028em; margin: 0 0 14px; }
  .intro__lede { font-size: 18px; line-height: 1.6; color: var(--ink-2); max-width: 62ch; margin: 0; }

  .tools { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(288px, 1fr)); gap: 18px; }
  .tool {
    background: var(--surface); border: 1px solid var(--rule); border-radius: 10px;
    padding: 22px; transition: border-color .15s, transform .15s;
  }
  .tool:hover { border-color: var(--rule-2); transform: translateY(-2px); }
  .tool h3 { margin: 0 0 8px; font-size: 17px; line-height: 1.3; }
  .tool h3 a { text-decoration: none; }
  .tool h3 a:hover { text-decoration: underline; }
  .tool p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--ink-2); }
  .tool__more { margin-top: 10px !important; font-size: 14.5px !important; }
</style>
