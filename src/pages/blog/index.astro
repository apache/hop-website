---
import Base from '../../layouts/Base.astro'
import { getCollection } from 'astro:content'
import { TYPES, typeOf, thumbOf, previewOf, tagsOf, tagSlug } from '../../data/post-types.mjs'

const posts = (await getCollection('blog'))
  .sort((a, b) => (b.data.publishDate?.getTime() ?? 0) - (a.data.publishDate?.getTime() ?? 0))
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    date: p.data.publishDate,
    authors: p.data.authors,
    type: typeOf(p),
    thumb: thumbOf(p),
    preview: previewOf(p),
  }))

const [featured, ...rest] = posts

/* Every tag, with how many posts carry it. Split so the version numbers do not
   drown the topics: there are twenty-odd versions with one post each. */
const tagCounts = new Map()
for (const p of await getCollection('blog')) {
  for (const t of tagsOf(p)) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1)
}
const isVersion = (t) => /^\d+(\.\d+)+$/.test(t)
const cmpVersion = (a, b) => {
  const pa = a.split('.').map(Number), pb = b.split('.').map(Number)
  for (let i = 0; i < Math.max(pa.length, pb.length); i++) {
    if ((pb[i] ?? 0) !== (pa[i] ?? 0)) return (pb[i] ?? 0) - (pa[i] ?? 0)
  }
  return 0
}
const topicTags = [...tagCounts].filter(([t]) => !isVersion(t))
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
const versionTags = [...tagCounts].filter(([t]) => isVersion(t))
  .sort((a, b) => cmpVersion(a[0], b[0]))
const counts = posts.reduce((acc, p) => ({ ...acc, [p.type]: (acc[p.type] ?? 0) + 1 }), {})
const filters = [
  { slug: 'all', label: 'All', n: posts.length },
  ...Object.values(TYPES).map((t) => ({ ...t, n: counts[t.slug] ?? 0 })).filter((t) => t.n > 0),
]

const full = (d) => d ? d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }) : ''
const short = (d) => d ? d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }) : ''
const iso = (d) => d ? d.toISOString().slice(0, 10) : undefined
const chip = (t) => ({ release: 'Release', roundup: 'Roundup', news: 'News' })[t]
---
<Base title="Blog" description="Release announcements and community news from the Apache Hop project.">
  <main class="blog" id="main" data-pagefind-ignore>
    <header class="blog__head">
      <h1>Blog</h1>
      <p class="blog__lede">
        Release announcements and community news from the Apache Hop project.{' '}
        <a href="/blog/index.xml">Subscribe via Atom</a>.
      </p>
    </header>

    {featured && (
      <a class="featured" href={`/blog/${featured.id}/`}>
        {featured.thumb && <div class="featured__media"><img src={featured.thumb} alt="" loading="eager" /></div>}
        <div class="featured__body">
          <p class="meta">
            <span class:list={['chip', `chip--${featured.type}`]}>{chip(featured.type)}</span>
            <time datetime={iso(featured.date)}>{full(featured.date)}</time>
            {featured.authors && <span class="meta__by">{featured.authors}</span>}
          </p>
          <h2>{featured.title}</h2>
          {featured.preview && <p class="featured__preview">{featured.preview}</p>}
          <span class="featured__more">Read the announcement &rarr;</span>
        </div>
      </a>
    )}

    <nav class="filters" aria-label="Filter posts">
      {filters.map((f, i) => (
        <button type="button" class="filter" data-filter={f.slug} aria-pressed={i === 0 ? 'true' : 'false'}>
          {f.label} <span class="filter__n">{f.n}</span>
        </button>
      ))}
    </nav>

    <ul class="grid" id="post-grid">
      {rest.map((p) => (
        <li class="card" data-type={p.type}>
          <a href={`/blog/${p.id}/`}>
            <p class="meta">
              <span class:list={['chip', `chip--${p.type}`]}>{chip(p.type)}</span>
              <time datetime={iso(p.date)}>{short(p.date)}</time>
              {p.authors && <span class="meta__by">{p.authors}</span>}
            </p>
            <h3>{p.title}</h3>
            {p.preview && <p class="card__preview">{p.preview}</p>}
          </a>
        </li>
      ))}
    </ul>
    <p class="grid__empty" id="grid-empty" hidden>No posts of that kind yet.</p>

    <section class="tags" aria-labelledby="tags-heading">
      <h2 id="tags-heading">Browse by tag</h2>
      <ul class="tags__list">
        {topicTags.map(([t, n]) => (
          <li><a href={`/blog/tag/${tagSlug(t)}/`}>{t}<span class="tags__n">{n}</span></a></li>
        ))}
      </ul>
      <h3 class="tags__sub">By release</h3>
      <ul class="tags__list tags__list--versions">
        {versionTags.map(([t, n]) => (
          <li><a href={`/blog/tag/${tagSlug(t)}/`}>{t}<span class="tags__n">{n}</span></a></li>
        ))}
      </ul>
    </section>
  </main>

  <script is:inline>
    // Progressive: with JS off, every post is shown and the buttons are inert.
    (function () {
      var grid = document.getElementById('post-grid')
      if (!grid) return
      var empty = document.getElementById('grid-empty')
      var buttons = [].slice.call(document.querySelectorAll('.filter'))
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var want = btn.getAttribute('data-filter')
          buttons.forEach(function (b) { b.setAttribute('aria-pressed', String(b === btn)) })
          var shown = 0
          ;[].slice.call(grid.children).forEach(function (li) {
            var match = want === 'all' || li.getAttribute('data-type') === want
            li.hidden = !match
            if (match) shown++
          })
          if (empty) empty.hidden = shown > 0
        })
      })
    })()
  </script>
</Base>

<style>
  .blog { max-width: 1180px; margin: 0 auto; padding: 40px 24px 24px; }
  .blog__head { margin-bottom: 32px; }
  .blog__head h1 { font-size: clamp(30px, 4vw, 42px); letter-spacing: -.028em; margin: 0 0 12px; }
  .blog__lede { font-size: 17.5px; color: var(--ink-2); max-width: 62ch; margin: 0; }

  .meta { display: flex; align-items: center; gap: 10px; margin: 0 0 10px; }
  .meta time, .meta__by { font-family: var(--mono); font-size: 12.5px; color: var(--ink-3); }
  .meta__by::before { content: "· "; color: var(--rule-2); }
  .chip {
    font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    padding: 3px 9px; border-radius: 999px; border: 1px solid var(--rule);
    background: var(--surface-2); color: var(--ink-2);
  }
  .chip--release { color: var(--accent); border-color: color-mix(in srgb, var(--accent) 35%, var(--rule)); }
  .chip--roundup { color: var(--brand); }

  /* featured */
  .featured {
    display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 0;
    background: var(--surface); border: 1px solid var(--rule); border-radius: 14px;
    overflow: hidden; text-decoration: none; color: inherit; margin-bottom: 36px;
    transition: border-color .15s;
  }
  .featured:hover { border-color: var(--accent); }
  .featured__media { background: var(--surface-2); display: grid; place-items: center; padding: 26px; }
  .featured__media img { width: 100%; max-height: 260px; object-fit: contain; }
  .featured__body { padding: 32px 34px; align-self: center; }
  .featured__body h2 { margin: 0 0 10px; font-size: clamp(21px, 2.6vw, 28px); line-height: 1.22; letter-spacing: -.02em; }
  .featured__preview { margin: 0 0 16px; color: var(--ink-2); font-size: 16px; line-height: 1.6; max-width: 46ch; }
  .featured__more { font-weight: 600; font-size: 15px; color: var(--accent); }
  @media (max-width: 820px) { .featured { grid-template-columns: 1fr; } .featured__body { padding: 24px; } }

  /* filters */
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 22px; }
  .filter {
    font: inherit; font-size: 14px; font-weight: 600; cursor: pointer;
    padding: 7px 14px; border-radius: 999px;
    border: 1px solid var(--rule); background: var(--surface); color: var(--ink-2);
  }
  .filter:hover { border-color: var(--rule-2); color: var(--ink); }
  .filter[aria-pressed="true"] { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .filter__n { opacity: .65; font-variant-numeric: tabular-nums; }

  /* grid */
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px; }
  .card { display: flex; }
  /* `display: flex` above is author CSS and beats the `hidden` attribute's
     user-agent `display: none`, so the filter set the attribute and the card
     stayed on screen. This restores it. */
  .card[hidden] { display: none; }
  /* Text only. The image belongs to the featured post, where it has the room
     to be worth looking at; repeating a thumbnail on every card made the grid
     busy without telling the reader anything. */
  .card > a {
    display: flex; flex-direction: column; width: 100%; text-decoration: none; color: inherit;
    background: var(--surface); border: 1px solid var(--rule); border-radius: 12px;
    padding: 20px 22px 22px; transition: border-color .15s, transform .15s;
  }
  .card > a:hover { border-color: var(--accent); transform: translateY(-2px); }
  .card h3 { margin: 0; font-size: 17px; line-height: 1.32; }
  .card__preview {
    margin: 9px 0 0; font-size: 14.5px; line-height: 1.6; color: var(--ink-2);
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .grid__empty { color: var(--ink-3); margin-top: 20px; }

  .tags { margin-top: 56px; padding-top: 32px; border-top: 1px solid var(--rule); }
  .tags h2 { margin: 0 0 18px; font-size: 20px; }
  .tags__sub { margin: 26px 0 12px; font-size: 12.5px; font-weight: 700; letter-spacing: .07em; text-transform: uppercase; color: var(--ink-3); }
  .tags__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags__list a {
    display: inline-flex; align-items: center; gap: 7px;
    padding: 6px 12px; border-radius: 999px;
    border: 1px solid var(--rule); background: var(--surface);
    color: var(--ink-2); text-decoration: none; font-size: 14px; font-weight: 600;
    transition: border-color .15s, color .15s;
  }
  .tags__list a:hover { border-color: var(--accent); color: var(--accent); }
  .tags__n { font-family: var(--mono); font-size: 11.5px; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .tags__list--versions a { font-weight: 500; }
</style>
