{{! Which manual and which version, at the foot of the navigation, the way the
    live site has it. A <details> rather than a <select> so it can show every
    manual and its versions together, and so it needs no JavaScript. }}
<div class="nav-foot">
  <details class="explore">
    <summary>
      <span class="explore__now">
        <span class="explore__component">{{page.component.title}}</span>
        <span class="explore__version">{{page.componentVersion.displayVersion}}</span>
      </span>
      <svg class="explore__chev" width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </summary>
    <div class="explore__body">
      {{! The manual you are reading comes first, then the rest. }}
      {{#with page.component}}{{> explore-group}}{{/with}}
      {{#each site.components}}
        {{#unless (eq this @root.page.component)}}{{> explore-group}}{{/unless}}
      {{/each}}
    </div>
  </details>

  {{#if page.editUrl}}
  <a class="nav-foot__edit" href="{{page.editUrl}}">
    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M11.013 1.427a1.75 1.75 0 0 1 2.474 0l1.086 1.086a1.75 1.75 0 0 1 0 2.474l-8.61 8.61c-.21.21-.47.364-.756.445l-3.251.93a.75.75 0 0 1-.927-.928l.929-3.25c.081-.286.235-.547.445-.758zm1.414 1.06a.25.25 0 0 0-.354 0L10.811 3.75l1.439 1.44 1.263-1.263a.25.25 0 0 0 0-.354zM11.189 6.25 9.75 4.81l-6.286 6.287a.25.25 0 0 0-.064.108l-.558 1.953 1.953-.558a.25.25 0 0 0 .108-.064z"/></svg>
    Edit this page
  </a>
  {{/if}}
</div>
