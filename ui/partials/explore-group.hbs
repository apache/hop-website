{{! One manual and its versions. Rendered from nav-footer twice: once for the
    manual you are reading, then once per other manual. }}
<div class="explore__group">
  <p class="explore__title">{{{title}}}</p>
  <ul>
    {{#each versions}}
    <li class="{{#if (and (eq .. @root.page.component) (eq this @root.page.componentVersion))}}is-current{{/if}}">
      <a href="{{{relativize ./url}}}">{{./displayVersion}}</a>
    </li>
    {{/each}}
  </ul>
</div>
