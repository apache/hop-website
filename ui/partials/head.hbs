<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{#if page.title}}{{{detag page.title}}} | {{site.title}}{{else}}{{site.title}}{{/if}}</title>
{{#with page.description}}<meta name="description" content="{{this}}">{{/with}}
{{#with page.keywords}}<meta name="keywords" content="{{this}}">{{/with}}
{{#with page.canonicalUrl}}<link rel="canonical" href="{{this}}">{{/with}}

{{! Social cards. The old site sent a 150x159 logo as og:image on all 7,289 pages. }}
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{site.title}}">
<meta property="og:title" content="{{#if page.title}}{{{detag page.title}}}{{else}}{{site.title}}{{/if}}">
{{#with page.description}}<meta property="og:description" content="{{this}}">{{/with}}
{{#with page.canonicalUrl}}<meta property="og:url" content="{{this}}">{{/with}}
<meta property="og:image" content="{{site.url}}/img/social-card.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:image" content="{{site.url}}/img/social-card.png">

<link rel="icon" href="{{siteRootPath}}/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="196x196" href="{{siteRootPath}}/favicon-196x196.png">
<link rel="manifest" href="{{siteRootPath}}/site.webmanifest">
<link rel="stylesheet" href="{{uiRootPath}}/css/site.css">

{{! Set the theme before first paint so a dark-mode reader never sees a white flash.
    Inline and tiny by necessity - it must run before the body renders. }}
<script>(function(){try{var t=localStorage.getItem('hop-theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}})()</script>
