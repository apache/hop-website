{{#if page.navigation.[0]}}
{{! A div around the named nav, not an aside: the nav inside already carries
    the label, and wrapping it in a complementary landmark added a second,
    unnamed one to the page outline for the same content. }}
<div class="doc-nav" id="doc-nav" data-pagefind-ignore>
  <button type="button" class="doc-nav__close icon-btn" aria-label="Close navigation">&times;</button>
  <nav aria-label="Documentation">
    {{#each page.navigation}}
    <div class="doc-nav__group">
      {{#if content}}<p class="doc-nav__title">{{#if url}}<a href="{{relativize url}}">{{{content}}}</a>{{else}}{{{content}}}{{/if}}</p>{{/if}}
      {{#if items}}{{> nav-tree items=items}}{{/if}}
    </div>
    {{/each}}
  </nav>
{{> nav-footer}}
</div>
{{/if}}
