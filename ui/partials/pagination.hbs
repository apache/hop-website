{{#if (or page.previous page.next)}}
<nav class="pagination" data-pagefind-ignore aria-label="Page">
  {{#with page.previous}}<a class="pagination__prev" href="{{relativize url}}"><span>Previous</span><strong>{{{content}}}</strong></a>{{/with}}
  {{#with page.next}}<a class="pagination__next" href="{{relativize url}}"><span>Next</span><strong>{{{content}}}</strong></a>{{/with}}
</nav>
{{/if}}
