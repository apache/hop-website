<!DOCTYPE html>
<html lang="en">
<head>
{{> head}}
</head>
<body class="content-page" data-pagefind-ignore>
{{> header}}
<main class="prose-main" id="main">
  <article class="prose notfound">
    <p class="notfound__code">404</p>
    <h1>We can't find that page</h1>
    <p>It may have moved when the documentation was reorganised, or the link may be out of date.</p>
    <p class="notfound__links">
      <a class="btn btn--primary" href="{{siteRootPath}}/manual/latest/">User manual</a>
      <a class="btn" href="{{siteRootPath}}/download/">Download</a>
      <a class="btn" href="{{siteRootPath}}/community/contributing/">Contributing</a>
    </p>
  </article>
</main>
{{> footer}}
</body>
</html>
